{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.codelives/ainecto",
  "title": "Ainecto",
  "description": "Ainecto MCP connector for workspace, document, ERD, diagram, task, and attachment workflows.",
  "version": "0.1.0",
  "websiteUrl": "https://ainecto.com",
  "repository": {
    "url": "https://github.com/codelives/ainecto",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@ainecto/mcp",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
