{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.ainecto/ainecto",
  "title": "AiNecto",
  "description": "Shared project memory for people and AI agents: workspaces, documents, ERD, diagrams and boards.",
  "version": "0.9.0",
  "websiteUrl": "https://ainecto.com",
  "repository": {
    "url": "https://github.com/codelives/ainecto",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://ainecto.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@ainecto/mcp",
      "version": "0.9.0",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
