{
  "name": "@ai-erd/mcp",
  "version": "0.2.0",
  "description": "AI-ERD MCP connector and first-party CLI.",
  "mcpName": "io.github.codelives/ainecto",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "homepage": "https://ainecto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/codelives/ainecto.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mcp": "dist/bin/mcp.js",
    "ainecto-mcp": "dist/bin/mcp.js",
    "ainecto": "dist/bin/ainecto.js",
    "ai-erd": "dist/bin/ainecto.js",
    "ai-erd-mcp": "dist/bin/mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/chmod-bins.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync:tools": "tsx scripts/sync-tools.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:attachments": "tsx scripts/smoke-attachment-upload.ts",
    "catalog:fixture": "vitest run test/catalog.test.ts",
    "prepack": "npm run typecheck && npm test && npm run build",
    "publish:both": "node scripts/publish-both.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.8",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
